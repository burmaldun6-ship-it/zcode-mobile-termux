# ZCode Mobile - project paths and host toolchain specification (aapt2 flow).
#
# This file is sourced by modules/builder/build_apk.sh. All paths are relative
# to PROJECT_ROOT (the repository checkout) unless stated otherwise.
# Legacy com.agy / language_server paths were removed during the aapt2 port.

PROJECT_ROOT="${PROJECT_ROOT:-${PROJECT:-$PWD}}"

# Android application sources owned by the Android agent.
APP_DIR="${APP_DIR:-$PROJECT_ROOT/app}"
APP_SRC_DIR="$APP_DIR/src/main"
JAVA_DIR="$APP_SRC_DIR/java"
RES_DIR="$APP_SRC_DIR/res"
MANIFEST="$APP_SRC_DIR/AndroidManifest.xml"

# Runtime / web assets bundled into the APK under assets/.
ASSETS_DIR="${ASSETS_DIR:-$PROJECT_ROOT/assets}"
BACKEND_ASSETS_DIR="$ASSETS_DIR/backend"
NODE_ASSETS_DIR="$ASSETS_DIR/node"
WEB_ASSETS_DIR="$ASSETS_DIR/web"

# Renderer bundle produced by the sibling desktop build (host-only source).
# 05_stage_assets.py copies this into the writable WEB_ASSETS_DIR when empty.
RENDERER_DIR="${RENDERER_DIR:-$PROJECT_ROOT/extracted/app/out/renderer}"
PRELOAD_DIR="${PRELOAD_DIR:-$PROJECT_ROOT/extracted/app/out/preload}"

# Env / bootstrap bundle. Extra .debs from ENV_DIR/packages are optional; when
# absent the bootstrap archive is built from bootstrap-aarch64.zip alone and
# package installation is deferred to runtime (see builder README).
ENV_DIR="${ENV_DIR:-$PROJECT_ROOT/env}"
BOOTSTRAP_ZIP="$ENV_DIR/bootstrap/bootstrap-aarch64.zip"
BOOTSTRAP_TAR="$ENV_DIR/bootstrap/bootstrap.tar.gz"
ENV_DIST="$ENV_DIR/dist/env"

# Builder outputs.
BUILD_DIR="${BUILD_DIR:-$PROJECT_ROOT/build}"
STAGING_DIR="$BUILD_DIR/staging"
DIST_DIR="${DIST_DIR:-$PROJECT_ROOT/dist}"

# Host toolchain. aapt v1 is NOT usable here (x86-64 only); aapt2 is required.
TOOLS_DIR="${TOOLS_DIR:-$PROJECT_ROOT/tools}"
ANDROID_JAR="${ANDROID_JAR:-$TOOLS_DIR/android.jar}"
R8_JAR="${R8_JAR:-$TOOLS_DIR/r8.jar}"
DEBUG_KEYSTORE="${DEBUG_KEYSTORE:-$TOOLS_DIR/debug.keystore}"
AAPT2="${AAPT2:-aapt2}"
